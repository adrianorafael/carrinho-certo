<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="3dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/gray_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/drag"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:contentDescription="Arrastar para reordenar"
            android:padding="4dp"
            android:src="@drawable/ic_drag"
            app:tint="@color/gray" />

        <FrameLayout
            android:id="@+id/dot"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_dot_gray">

            <ImageView
                android:id="@+id/dotIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gray"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/star"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Prioritário"
            android:src="@drawable/ic_star_border"
            app:tint="@color/gray" />

        <ImageButton
            android:id="@+id/scan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dot_blue"
            android:contentDescription="Ler preço deste item"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mais opções"
            android:src="@drawable/ic_more"
            app:tint="@color/gray" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
